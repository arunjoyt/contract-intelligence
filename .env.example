# Copy to .env and fill in real values. Never commit .env.

# ERPNext connection
ERPNEXT_URL=https://erp.example.com
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
WEBHOOK_SECRET=

# OpenAI (embeddings + GPT-4o)
OPENAI_API_KEY=

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=procurement

# Langfuse (tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Langfuse internal secrets — required by docker-compose.yml
# Generate with: openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ADMIN_PASSWORD=

# Frontend
BACKEND_URL=http://localhost:8000

# Admin
ADMIN_SECRET=

# Pipeline behavior
QUERY_REWRITE_STRATEGY=hyde

# Auth (Option B — ERPNext OAuth2 + JWT)
# Create an OAuth client in ERPNext desk: Integrations → OAuth Client
ERPNEXT_OAUTH_CLIENT_ID=
ERPNEXT_OAUTH_CLIENT_SECRET=
# Must match the Redirect URI configured in the ERPNext OAuth client
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
# Streamlit URL — FastAPI redirects here with ?token=<jwt> after login
FRONTEND_URL=http://localhost:8501
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY_HOURS=8
ALLOWED_ROLES=Purchase Manager,Purchase User,Accounts User,System Manager
