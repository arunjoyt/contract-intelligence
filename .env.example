# Copy to .env and fill in real values. Never commit .env.

# ERPNext connection
ERPNEXT_URL=https://erp.example.com
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# Generate with: openssl rand -hex 32
# Must match the Webhook Secret field in every ERPNext Webhook record.
# Production webhook URL: https://api.procurement-rag.example.com/webhook/erpnext
WEBHOOK_SECRET=

# OpenAI (embeddings + GPT-4o)
OPENAI_API_KEY=

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=procurement

# Langfuse (tracing)
# For self-hosted Langfuse (docker-compose.yml): these values seed the project on
# first boot AND are used by the app to connect. Generate with: openssl rand -hex 16
# For Langfuse Cloud: use the keys from your Langfuse project settings.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Langfuse internal secrets — required by docker-compose.yml (self-hosted only)
# Generate each with: openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ADMIN_PASSWORD=
# External URL for the self-hosted Langfuse UI (used by NextAuth redirects).
# Leave as default for local dev; set to https://... for production.
LANGFUSE_NEXTAUTH_URL=http://localhost:3000

# Frontend
BACKEND_URL=http://localhost:8000
# Externally reachable FastAPI URL — used for browser-visible OAuth redirects.
# In production (behind nginx) set this to the public API domain.
# Leave unset for local dev where BACKEND_URL is already localhost.
PUBLIC_API_URL=

# Admin — gate for POST /ingest/full; must be a strong random value in production
# Generate with: openssl rand -hex 32
ADMIN_SECRET=

# Nginx (production only) — bare hostnames, no scheme. Substituted into
# nginx/templates/procurement-rag.conf.template at container start, so nginx.conf
# never needs manual editing. Leave unset for local dev (nginx isn't used).
FRONTEND_DOMAIN=procurement-rag.example.com
API_DOMAIN=api.procurement-rag.example.com

# Pipeline behavior
QUERY_REWRITE_STRATEGY=hyde

# Model configuration (see config.py) — change to swap the generation or
# embedding model without touching code.
# WARNING: EMBEDDING_MODEL must map to a known dimension in config.py's
# _EMBEDDING_DIMENSIONS. Changing it to a model with a different dimension
# requires recreating the Qdrant collection and running a full re-ingest.
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Auth (Option B — ERPNext OAuth2 + JWT)
# Create an OAuth client in ERPNext desk: Integrations → OAuth Client
ERPNEXT_OAUTH_CLIENT_ID=
ERPNEXT_OAUTH_CLIENT_SECRET=
# Must match the Redirect URI configured in the ERPNext OAuth client
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
# Streamlit URL — FastAPI redirects here with ?token=<jwt> after login
FRONTEND_URL=http://localhost:8501
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY_HOURS=8
ALLOWED_ROLES=Purchase Manager,Purchase User,Accounts User,System Manager
