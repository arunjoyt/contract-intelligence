# Copy to .env and fill in real values. Never commit .env.

# ERPNext connection
ERPNEXT_URL=https://erp.example.com
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
WEBHOOK_SECRET=

# OpenAI (embeddings + GPT-4o)
OPENAI_API_KEY=

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=procurement

# Langfuse (tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Frontend
BACKEND_URL=http://localhost:8000

# Admin
ADMIN_SECRET=

# Pipeline behavior
QUERY_REWRITE_STRATEGY=hyde
